#!/usr/bin/env bash
cd "$(dirname "$0")"
HERE="$(pwd)"
PORT="${WORKPLACE_PORT:-4747}"
api() { curl -s -m 3 -H "x-agentos-token: $(cat data/app-token 2>/dev/null)" "http://127.0.0.1:$PORT$1"; }
up() { [ -s data/app-token ] && api /api/limits | grep -q '{'; }

case "$1" in
  stop) shift; exec ./stop.sh "$@" ;;
  restart) ./stop.sh -f; sleep 1; shift; exec "$0" "$@" ;;
  status)
    if up; then
      api /api/state | node -e '
        const s = JSON.parse(require("fs").readFileSync(0));
        const run = s.agents.filter((a) => ["running", "delegating", "queued"].includes(a.status) || (a.resident && a.current));
        console.log(`Agentic OS is running: ${s.agents.length} processes, ${run.length} active, ${s.tickets.filter((t) => t.status === "open").length} open jobs.`);'
    else echo "Agentic OS is not running."; fi
    exit 0 ;;
  install)
    mkdir -p "$HOME/.local/share/applications"
    cat > "$HOME/.local/share/applications/agentos.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Agentic OS
Comment=Your permanent team of Claude agents
Exec=$HERE/agentos
Icon=$HERE/app/icon.png
Terminal=false
Categories=Development;Utility;
StartupWMClass=AgenticOS
EOF
    command -v update-desktop-database >/dev/null && update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1
    echo "Installed: Agentic OS is in your applications menu."
    exit 0 ;;
  uninstall) rm -f "$HOME/.local/share/applications/agentos.desktop"; echo "Removed from the applications menu."; exit 0 ;;
  -h|--help|help)
    echo "usage: ./agentos [status|stop [-f]|restart|install|uninstall]"
    echo "  (no argument) start the backend if needed and open the Agentic OS window"
    exit 0 ;;
esac

if ! up; then
  nohup node server.js >> data/server.log 2>&1 &
  for _ in $(seq 1 40); do up && break; sleep 0.25; done
  up || { echo "The server did not start; see data/server.log"; exit 1; }
fi

python3 -c "import gi; gi.require_version('WebKit2', '4.0')" 2>/dev/null || { echo "Needs python3-gi and gir1.2-webkit2-4.0 (sudo apt install python3-gi gir1.2-webkit2-4.0)."; exit 1; }
WORKPLACE_PORT="$PORT" nohup python3 app/agentos-window.py >/dev/null 2>&1 &
echo "Agentic OS is open."
