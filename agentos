#!/usr/bin/env bash
cd "$(dirname "$0")"
HERE="$(pwd)"
PORT="${WORKPLACE_PORT:-4747}"
api() { curl -s -m 3 -H "x-agentos-token: $(cat data/app-token 2>/dev/null)" "http://127.0.0.1:$PORT$1"; }
up() { [ -s data/app-token ] && api /api/limits | grep -q '{'; }

# First run from a terminal: the setup wizard asks where your projects live instead of copying the examples.
if [ -z "$1" ] && [ ! -f projects.json ] && [ -t 0 ]; then node scripts/setup.js || exit 1; fi

case "$1" in
  stop) shift; exec ./lib/stop.sh "$@" ;;
  setup) shift; exec node scripts/setup.js "$@" ;;
  demo) shift; exec node scripts/demo.js "$@" ;;
  restart)
    if [ "$2" = "--when-idle" ] || [ "$2" = "-i" ]; then
      if up; then
        curl -s -m 3 -X POST -H "x-agentos-token: $(cat data/app-token)" -H 'content-type: application/json' -d "{\"when\":\"idle\",\"check\":$([ "$3" = "--no-check" ] && echo false || echo true)}" "http://127.0.0.1:$PORT/api/restart" | node -e '
          let r = {}; try { r = JSON.parse(require("fs").readFileSync(0)); } catch {}
          if (!Array.isArray(r.busy)) { console.log("The running server is older than this command. Restart it once with ./agentos restart when nothing is working; after that, --when-idle works."); process.exit(1); }
          console.log(r.busy.length ? `Restarts as soon as nothing is running (working now: ${r.busy.join(", ")}). New work waits until then; the window reloads by itself.` : "Restarting now; the window reloads by itself.");'
        exit 0
      fi
      shift 2; exec "$0" "$@"
    fi
    if [ "$2" = "--cancel" ]; then
      curl -s -m 3 -X POST -H "x-agentos-token: $(cat data/app-token)" -H 'content-type: application/json' -d '{"when":"cancel"}' "http://127.0.0.1:$PORT/api/restart" >/dev/null && echo "Restart cancelled."; exit 0
    fi
    ./lib/stop.sh -f; sleep 1; shift; exec "$0" "$@" ;;
  status)
    if up; then
      api /api/state | node -e '
        const s = JSON.parse(require("fs").readFileSync(0));
        const run = s.agents.filter((a) => ["running", "delegating", "queued"].includes(a.status) || (a.resident && a.current));
        console.log(`Agentic OS is running: ${s.agents.length} processes, ${run.length} active, ${s.tickets.filter((t) => t.status === "open").length} open jobs.`);'
    else echo "Agentic OS is not running."; fi
    exit 0 ;;
  install)
    mkdir -p "$HOME/.local/share/applications"
    cat > "$HOME/.local/share/applications/agentos.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Agentic OS
Comment=Your permanent team of Claude agents
Exec=$HERE/agentos
Icon=$HERE/app/icon.png
Terminal=false
Categories=Development;Utility;
StartupWMClass=AgenticOS
EOF
    command -v update-desktop-database >/dev/null && update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1
    echo "Installed: Agentic OS is in your applications menu."
    exit 0 ;;
  uninstall) rm -f "$HOME/.local/share/applications/agentos.desktop"; echo "Removed from the applications menu."; exit 0 ;;
  autostart)
    f="$HOME/.config/autostart/agentos.desktop"
    if [ "$2" = "off" ]; then rm -f "$f"; echo "Agentic OS no longer starts at login."; exit 0; fi
    mkdir -p "$(dirname "$f")"
    printf '[Desktop Entry]\nType=Application\nName=Agentic OS\nComment=Your permanent team of Claude agents\nExec=%s --background\nIcon=%s\nTerminal=false\nX-GNOME-Autostart-enabled=true\n' "$HERE/agentos" "$HERE/app/icon.png" > "$f"
    echo "Agentic OS starts at login, in the tray (./agentos autostart off to undo)."; exit 0 ;;
  -h|--help|help)
    echo "usage: ./agentos [--background|--browser|status|stop [-f]|restart [--when-idle|--cancel]|setup|demo|install|uninstall|autostart on|off]"
    echo "  (no argument)                      start the backend if needed and open the Agentic OS window (first run: setup)"
    echo "  --browser, -b                      open the office in your default browser instead (macOS, WSL, any Linux)"
    echo "  setup [--yes]                      check requirements and set up your team and projects"
    echo "  demo [--no-window] [--keep]        a throwaway office with stand-in agents: no Claude account, nothing spent"
    echo "  restart --when-idle [--no-check]   finish running work, hold new work, check the new version, then restart; the window reloads"
    exit 0 ;;
esac

if ! up; then
  nohup node server.js >> data/server.log 2>&1 &
  for _ in $(seq 1 40); do up && break; sleep 0.25; done
  up || { echo "The server did not start; see data/server.log"; exit 1; }
fi

# The office in your default browser: macOS, WSL, or Linux without the GTK window. A one-time launch code lets the
# browser in, so the app token never lands in a URL or the browser's history.
open_browser() {
  link="$(curl -s -m 3 -X POST -H "x-agentos-token: $(cat data/app-token)" "http://127.0.0.1:$PORT/__launch" | node -e 'try { process.stdout.write(JSON.parse(require("fs").readFileSync(0)).url || ""); } catch {}')"
  [ -n "$link" ] || { echo "Could not get a launch link from the server; see data/server.log"; exit 1; }
  if [ "$(uname)" = "Darwin" ]; then open "$link"
  elif grep -qi microsoft /proc/version 2>/dev/null && command -v cmd.exe >/dev/null; then cmd.exe /c start "" "$link" >/dev/null 2>&1
  elif command -v xdg-open >/dev/null; then xdg-open "$link" >/dev/null 2>&1 &
  else echo "Open this link in your browser within a minute (it works once): $link"; exit 0; fi
  echo "Agentic OS is open in your browser. The office keeps running when you close the tab; ./agentos stop ends it."
  exit 0
}
[ "$1" = "--browser" ] || [ "$1" = "-b" ] && open_browser
if ! python3 -c "import gi; gi.require_version('WebKit2', '4.0')" 2>/dev/null; then
  if [ "$(uname)" = "Linux" ] && ! grep -qi microsoft /proc/version 2>/dev/null; then
    echo "The desktop window needs python3-gi and gir1.2-webkit2-4.0 (sudo apt install python3-gi gir1.2-webkit2-4.0); opening your browser instead."
  fi
  open_browser
fi
WORKPLACE_PORT="$PORT" nohup python3 app/agentos-window.py $([ "$1" = "--background" ] && echo --background) >/dev/null 2>&1 &
[ "$1" = "--background" ] && echo "Agentic OS is running in the tray." || echo "Agentic OS is open."
