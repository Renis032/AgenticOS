# Runtime state, not code: agents, jobs, conversations, logs, uploads, backups and the app token.
data/
# Daily snapshots of data/ (lib/backups.js).
backups/
# Python bytecode
__pycache__/
*.pyc
# Local office knowledge and config: team libraries, handoffs, skills, and the roster/projects (they may name the user's employer).
# A fresh clone starts from roster.example.json and projects.example.json.
teams/
roster.json
projects.json
# Your reading inbox and generated artifacts: personal content, created at runtime (lib/arms.js).
inbox/*
artifacts/*
!inbox/.gitkeep
!artifacts/.gitkeep
# Development tools (ESLint); the app itself has no dependencies.
node_modules/
